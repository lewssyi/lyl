{
  "objective": "Reach >=0.85 validation/test selected accuracy by improving A1 zero core training, not postprocessing.",
  "python": "/home/b502/app/anaconda3/envs/l_venv/bin/python3.11",
  "workspace": "/home/b502/wssyi/LIME-for-Time-Series",
  "target_accuracy": 0.85,
  "gpu_policy": {
    "preferred_gpus": "6,7",
    "fallback_gpu_sets": ["0,1", "2,3", "4,5"],
    "max_used_memory_mb_per_gpu": 6000,
    "max_utilization_pct_per_gpu": 10,
    "max_compute_processes_per_gpu": 0,
    "poll_seconds": 600,
    "require_requested_gpus": true
  },
  "default_args": {
    "split_json": "dataset_protocols/ISRUC/split.json",
    "per_replica_batch": 16,
    "predict_per_replica_batch": 16,
    "seed": 42,
    "memory_profile": "balanced"
  },
  "experiments": [
    {
      "name": "a1zero_lfts_probs",
      "branch": "exp/a1zero-lfts-probs",
      "preset": "isruc_A1_concept_film_zero",
      "hypothesis": "A1 zero from-scratch baseline with train/val/test split probabilities exported for hard-example mining.",
      "env": {
        "LFTS_RUN_TAG": "isruc_A1_zero_probs",
        "LFTS_SAVE_PREDICTION_PROBS": "1",
        "LFTS_SAVE_SPLIT_PREDICTION_PROBS": "1",
        "LFTS_PREPROCESS_FILTER_PROFILE": "clinical_canonical",
        "LFTS_PREPROCESS_FILTER_BACKEND": "scipy",
        "LFTS_PREPROCESS_NORMALIZATION_MODE": "recording_robust_zscore"
      }
    },
    {
      "name": "hard_example_finetune",
      "branch": "exp/hard-example-finetune",
      "base_branch": "exp/a1zero-lfts-probs",
      "depends_on": "a1zero_lfts_probs",
      "preset": "isruc_A1_concept_film_zero_hard_risk",
      "build_risk_weights": true,
      "hypothesis": "Validation-confusion and train uncertainty identify W/N1/N2/REM hard epochs; custom risk-weighted loss plus epoch sample weights improve accuracy.",
      "env": {
        "LFTS_RUN_TAG": "isruc_A1_zero_hard_risk",
        "LFTS_SAVE_PREDICTION_PROBS": "1",
        "LFTS_SAVE_SPLIT_PREDICTION_PROBS": "1",
        "LFTS_LOSS_NAME": "risk_weighted_n1_margin_focal",
        "LFTS_RISK_SAMPLE_WEIGHT_STRENGTH": "1.0",
        "LFTS_RISK_SAMPLE_WEIGHT_MAX": "2.75",
        "LFTS_PREPROCESS_FILTER_PROFILE": "clinical_canonical",
        "LFTS_PREPROCESS_FILTER_BACKEND": "scipy",
        "LFTS_PREPROCESS_NORMALIZATION_MODE": "recording_robust_zscore"
      }
    },
    {
      "name": "robust_scale_bandpass",
      "branch": "exp/robust-scale-bandpass",
      "base_branch": "exp/hard-example-finetune",
      "depends_on": "hard_example_finetune",
      "preset": "isruc_A1_concept_film_zero_hard_risk",
      "reuse_best_risk_weights": true,
      "hypothesis": "Wider EEG 0.3-35 Hz band preserves K-complex/spindle evidence while robust z-score keeps ISRUC amplitude artifacts contained.",
      "env": {
        "LFTS_RUN_TAG": "isruc_A1_zero_hard_spindle_safe",
        "LFTS_SAVE_PREDICTION_PROBS": "1",
        "LFTS_SAVE_SPLIT_PREDICTION_PROBS": "1",
        "LFTS_LOSS_NAME": "risk_weighted_n1_margin_focal",
        "LFTS_PREPROCESS_FILTER_PROFILE": "spindle_safe_0p3_35",
        "LFTS_PREPROCESS_FILTER_BACKEND": "scipy",
        "LFTS_PREPROCESS_NORMALIZATION_MODE": "recording_robust_zscore"
      }
    },
    {
      "name": "channel_zscore_bandpass",
      "branch": "exp/channel-zscore-bandpass",
      "base_branch": "exp/hard-example-finetune",
      "depends_on": "hard_example_finetune",
      "preset": "isruc_A1_concept_film_zero_hard_risk",
      "reuse_best_risk_weights": true,
      "hypothesis": "Channel z-score with spindle-safe filter may improve clean signal propagation if robust scaling over-compresses spindle/K-complex morphology.",
      "env": {
        "LFTS_RUN_TAG": "isruc_A1_zero_hard_zscore_03535",
        "LFTS_SAVE_PREDICTION_PROBS": "1",
        "LFTS_SAVE_SPLIT_PREDICTION_PROBS": "1",
        "LFTS_LOSS_NAME": "risk_weighted_n1_margin_focal",
        "LFTS_PREPROCESS_FILTER_PROFILE": "spindle_safe_0p3_35",
        "LFTS_PREPROCESS_FILTER_BACKEND": "scipy",
        "LFTS_PREPROCESS_NORMALIZATION_MODE": "channel_zscore"
      }
    },
    {
      "name": "mne_minmax_probe",
      "branch": "exp/mne-minmax-probe",
      "base_branch": "exp/hard-example-finetune",
      "depends_on": "hard_example_finetune",
      "preset": "isruc_A1_concept_film_zero_hard_risk",
      "reuse_best_risk_weights": true,
      "hypothesis": "MNE FIR filtering plus robust min-max scaling is a sensitivity probe for whether IIR preprocessing suppresses morphology.",
      "env": {
        "LFTS_RUN_TAG": "isruc_A1_zero_hard_mne_minmax",
        "LFTS_SAVE_PREDICTION_PROBS": "1",
        "LFTS_SAVE_SPLIT_PREDICTION_PROBS": "1",
        "LFTS_LOSS_NAME": "risk_weighted_n1_margin_focal",
        "LFTS_PREPROCESS_FILTER_PROFILE": "spindle_safe_0p3_35",
        "LFTS_PREPROCESS_FILTER_BACKEND": "mne",
        "LFTS_PREPROCESS_NORMALIZATION_MODE": "recording_robust_minmax"
      }
    }
  ]
}
